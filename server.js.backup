app.post("/api/settings/gemini-key", (req, res) => {
  try {
    const { apiKey } = req.body;

    if (!apiKey) {
      return res.status(400).json({
        success: false,
        message: "API key is required",
      });
    }

    process.env.GEMINI_API_KEY = apiKey;

    res.json({
      success: true,
      message: "Gemini API key configured for current server session",
    });
  } catch (error) {
    console.error("Gemini key error:", error);

    res.status(500).json({
      success: false,
      message: "Failed to configure Gemini key",
      error: error.message,
    });
  }
});

