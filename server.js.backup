// ============================================================
// CREATE TASK - FIXED UNIQUE TASK CODE
// ============================================================

app.post("/api/tasks", (req, res) => {
  try {
    const {
      title,
      description,
      meeting_id,
      assignee_id,
      assigned_to,
      priority,
      status,
      deadline,
      due_date,
      role,
    } = req.body;

    if (!title) {
      return res.status(400).json({
        success: false,
        message: "Task title is required",
      });
    }

    // Generate a unique task code
    const taskCode = generateNextTaskCode();

    const result = db.run(
      `
      INSERT INTO tasks
      (
        task_code,
        title,
        description,
        meeting_id,
        assignee_id,
        assigned_to,
        priority,
        status,
        deadline,
        due_date,
        role
      )
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
      `,
      [
        taskCode,
        title,
        description || "",
        meeting_id || null,
        assignee_id || null,
        assigned_to || "",
        priority || "medium",
        status || "pending",
        deadline || null,
        due_date || null,
        role || "",
      ]
    );

    const task = db.get(
      `SELECT * FROM tasks WHERE id = ?`,
      [result.lastID]
    );

    res.status(201).json({
      success: true,
      message: "Task created successfully",
      task,
    });
  } catch (error) {
    console.error("Create task error:", error);

    res.status(500).json({
      success: false,
      message: "Failed to create task",
      error: error.message,
    });
  }
});

app.put("/api/tasks/:id", (req, res) => {
  try {
    const {
      title,
      description,
      assignee_id,
      assigned_to,
      priority,
      status,
      deadline,
      due_date,
      role,
    } = req.body;

    const oldTask = db.get(
      `SELECT * FROM tasks WHERE id = ?`,
      [req.params.id]
    );

    if (!oldTask) {
      return res.status(404).json({
        success: false,
        message: "Task not found",
      });
    }

    db.run(
      `
      UPDATE tasks
      SET
        title = COALESCE(?, title),
        description = COALESCE(?, description),
        assignee_id = COALESCE(?, assignee_id),
        assigned_to = COALESCE(?, assigned_to),
        priority = COALESCE(?, priority),
        status = COALESCE(?, status),
        deadline = COALESCE(?, deadline),
        due_date = COALESCE(?, due_date),
        role = COALESCE(?, role),
        updated_at = CURRENT_TIMESTAMP
      WHERE id = ?
      `,
      [
        title,
        description,
        assignee_id,
        assigned_to,
        priority,
        status,
        deadline,
        due_date,
        role,
        req.params.id,
      ]
    );

    db.run(
      `
      INSERT INTO task_history
      (task_id, old_status, new_status, note)
      VALUES (?, ?, ?, ?)
      `,
      [
        req.params.id,
        oldTask.status,
        status || oldTask.status,
        "Task updated",
      ]
    );

    const task = db.get(
      `SELECT * FROM tasks WHERE id = ?`,
      [req.params.id]
    );

    res.json({
      success: true,
      task,
    });
  } catch (error) {
    console.error("Update task error:", error);

    res.status(500).json({
      success: false,
      message: "Failed to update task",
      error: error.message,
    });
  }
});

app.delete("/api/tasks/:id", (req, res) => {
  try {
    db.run(
      `DELETE FROM task_history WHERE task_id = ?`,
      [req.params.id]
    );

    db.run(
      `DELETE FROM tasks WHERE id = ?`,
      [req.params.id]
    );

    res.json({
      success: true,
      message: "Task deleted successfully",
    });
  } catch (error) {
    console.error("Delete task error:", error);

    res.status(500).json({
      success: false,
      message: "Failed to delete task",
      error: error.message,
    });
  }
});

// ============================================================
// DECISIONS
// ============================================================

app.get("/api/decisions", (req, res) => {
  try {
    const decisions = db.all(`
      SELECT
        d.*,
        m.title AS meeting_title
      FROM decisions d
      LEFT JOIN meetings m ON m.id = d.meeting_id
      ORDER BY d.created_at DESC
    `);

    res.json({
      success: true,
      decisions: decisions || [],
    });
  } catch (error) {
    console.error("Decisions error:", error);

    res.status(500).json({
      success: false,
      message: "Failed to fetch decisions",
      error: error.message,
    });
  }
});

app.get("/api/decisions/meeting/:meetingId", (req, res) => {
  try {
    const decisions = db.all(
      `
      SELECT *
      FROM decisions
      WHERE meeting_id = ?
      ORDER BY created_at DESC
      `,
      [req.params.meetingId]
    );

    res.json({
      success: true,
      decisions: decisions || [],
    });
  } catch (error) {
    console.error("Meeting decisions error:", error);

    res.status(500).json({
      success: false,
      message: "Failed to fetch meeting decisions",
      error: error.message,
    });
  }
});

app.post("/api/decisions", (req, res) => {
  try {
    const {
      meeting_id,
      title,
      description,
      decision,
      made_by,
    } = req.body;

    const finalTitle = title || decision;

    if (!finalTitle) {
      return res.status(400).json({
        success: false,
        message: "Decision title is required",
      });
    }

    const result = db.run(
      `
      INSERT INTO decisions
      (
        meeting_id,
        title,
        description,
        decision,
        made_by
      )
      VALUES (?, ?, ?, ?, ?)
      `,
      [
        meeting_id || null,
        finalTitle,
        description || "",
        decision || finalTitle,
        made_by || "",
      ]
    );

    const createdDecision = db.get(
      `SELECT * FROM decisions WHERE id = ?`,
      [result.lastID]
    );

    res.status(201).json({
      success: true,
      decision: createdDecision,
    });
  } catch (error) {
    console.error("Create decision error:", error);

    res.status(500).json({
      success: false,
      message: "Failed to create decision",
      error: error.message,
    });
  }
});

// ============================================================
// TIMELINE / CROSS MEETING
// ============================================================

app.get("/api/timeline", (req, res) => {
  try {
    const meetings = db.all(`
      SELECT
        id,
        title,
        meeting_date,
        status,
        summary,
        executive_overview,
        created_at
      FROM meetings
      ORDER BY meeting_date ASC, id ASC
    `);

    const timeline = (meetings || []).map((meeting) => {
      const tasks = db.all(
        `
        SELECT *
        FROM tasks
        WHERE meeting_id = ?
        ORDER BY created_at ASC
        `,
        [meeting.id]
      );

      const decisions = db.all(
        `
        SELECT *
        FROM decisions
        WHERE meeting_id = ?
        ORDER BY created_at ASC
        `,
        [meeting.id]
      );

      return {
        ...meeting,
        summary:
          meeting.summary ||
          meeting.executive_overview ||
          "",
        tasks: tasks || [],
        decisions: decisions || [],
      };
    });

    res.json({
      success: true,
      timeline,
    });
  } catch (error) {
    console.error("Timeline error:", error);

    res.status(500).json({
      success: false,
      message: "Failed to fetch timeline",
      error: error.message,
    });
  }
});

// ============================================================
// AI QUERY
// ============================================================

app.post("/api/ai/query", (req, res) => {
  try {
    const { query } = req.body;

    if (!query) {
      return res.status(400).json({
        success: false,
        message: "Query is required",
      });
    }

    const lowerQuery = query.toLowerCase();

    const meetings = db.all(`
      SELECT *
      FROM meetings
      ORDER BY meeting_date DESC
      LIMIT 20
    `);

    const tasks = db.all(`
      SELECT
        t.*,
        u.name AS assignee_name,
        m.title AS meeting_title
      FROM tasks t
      LEFT JOIN users u ON u.id = t.assignee_id
      LEFT JOIN meetings m ON m.id = t.meeting_id
      ORDER BY t.created_at DESC
      LIMIT 50
    `);

    const decisions = db.all(`
      SELECT
        d.*,
        m.title AS meeting_title
      FROM decisions d
      LEFT JOIN meetings m ON m.id = d.meeting_id
      ORDER BY d.created_at DESC
      LIMIT 50
    `);

    let answer =
      "I found the following information from your meeting data.";

    if (
      lowerQuery.includes("last meeting") ||
      lowerQuery.includes("previous meeting")
    ) {
      const lastMeeting = meetings?.[0];

      if (lastMeeting) {
        answer = `
Last meeting: ${lastMeeting.title}

Date: ${lastMeeting.meeting_date || "Not available"}

Summary:
${
  lastMeeting.summary ||
  lastMeeting.executive_overview ||
  "No summary available"
}
        `.trim();
      } else {
        answer = "No previous meetings found.";
      }
    } else if (
      lowerQuery.includes("pending") ||
      lowerQuery.includes("in progress") ||
      lowerQuery.includes("task")
    ) {
      const relevantTasks = (tasks || []).filter(
        (task) => task.status !== "completed"
      );

      if (relevantTasks.length > 0) {
        answer =
          "Pending / ongoing tasks:\n\n" +
          relevantTasks
            .map(
              (task) =>
                `• ${task.title} — ${
                  task.assignee_name ||
                  task.assigned_to ||
                  "Unassigned"
                } — ${task.status || "pending"}`
            )
            .join("\n");
      } else {
        answer = "No pending tasks found.";
      }
    } else if (
      lowerQuery.includes("decision") ||
      lowerQuery.includes("decide")
    ) {
      if (decisions?.length > 0) {
        answer =
          "Recent decisions:\n\n" +
          decisions
            .slice(0, 10)
            .map(
              (decision) =>
                `• ${
                  decision.title ||
                  decision.decision
                }`
            )
            .join("\n");
      } else {
        answer = "No decisions found.";
      }
    } else {
      const matchingMeetings = (meetings || []).filter(
        (meeting) =>
          `${meeting.title || ""} ${
            meeting.summary || ""
          }`
            .toLowerCase()
            .includes(lowerQuery)
      );

      const matchingTasks = (tasks || []).filter(
        (task) =>
          `${task.title || ""} ${
            task.description || ""
          }`
            .toLowerCase()
            .includes(lowerQuery)
      );

      answer = `
Query: ${query}

Matching meetings: ${matchingMeetings.length}
Matching tasks: ${matchingTasks.length}

${
  matchingMeetings.length
    ? matchingMeetings
        .slice(0, 5)
        .map(
          (m) =>
            `• Meeting: ${m.title}`
        )
        .join("\n")
    : "No matching meetings found."
}

${
  matchingTasks.length
    ? matchingTasks
        .slice(0, 5)
        .map(
          (t) =>
            `• Task: ${t.title}`
        )
        .join("\n")
    : "No matching tasks found."
}
      `.trim();
    }

    res.json({
      success: true,
      query,
      answer,
    });
  } catch (error) {
    console.error("AI query error:", error);

    res.status(500).json({
      success: false,
      message: "AI query failed",
      error: error.message,
    });
  }
});

// ============================================================
// DASHBOARD
// ============================================================

app.get("/api/dashboard", (req, res) => {
  try {
    const meetingRow = db.get(
      `SELECT COUNT(*) AS c FROM meetings`
    );

    const taskRow = db.get(
      `SELECT COUNT(*) AS c FROM tasks`
    );

    const completedTaskRow = db.get(
      `
      SELECT COUNT(*) AS c
      FROM tasks
      WHERE LOWER(status) = 'completed'
      `
    );

    const pendingTaskRow = db.get(
      `
      SELECT COUNT(*) AS c
      FROM tasks
      WHERE LOWER(status) IN
      ('pending', 'in-progress', 'in progress', 'ongoing')
      `
    );

    const decisionRow = db.get(
      `SELECT COUNT(*) AS c FROM decisions`
    );

    const userRow = db.get(
      `SELECT COUNT(*) AS c FROM users`
    );

    const totalMeetings = meetingRow?.c || 0;
    const totalTasks = taskRow?.c || 0;
    const completedTasks = completedTaskRow?.c || 0;
    const pendingTasks = pendingTaskRow?.c || 0;
    const totalDecisions = decisionRow?.c || 0;
    const totalUsers = userRow?.c || 0;

    const recentMeetings = db.all(`
      SELECT
        id,
        title,
        meeting_date,
        status,
        summary
      FROM meetings
      ORDER BY created_at DESC
      LIMIT 5
    `);

    const recentTasks = db.all(`
      SELECT
        t.*,
        u.name AS assignee_name
      FROM tasks t
      LEFT JOIN users u
        ON u.id = t.assignee_id
      ORDER BY t.created_at DESC
      LIMIT 5
    `);

    res.json({
      success: true,

      stats: {
        totalMeetings,
        totalTasks,
        completedTasks,
        pendingTasks,
        totalDecisions,
        totalUsers,

        meetings: totalMeetings,
        tasks: totalTasks,
        completed: completedTasks,
        pending: pendingTasks,
        decisions: totalDecisions,
        users: totalUsers,
      },

      recentMeetings: recentMeetings || [],
      recentTasks: recentTasks || [],
    });
  } catch (error) {
    console.error("Dashboard error:", error);

    res.status(500).json({
      success: false,
      message: "Failed to load dashboard",
      error: error.message,
    });
  }
});

// ============================================================
// SEARCH
// ============================================================

app.get("/api/search", (req, res) => {
  try {
    const query = req.query.q || "";

    if (!query.trim()) {
      return res.json({
        success: true,
        results: [],
      });
    }

    const searchTerm = `%${query}%`;

    const meetings = db.all(
      `
      SELECT
        id,
        title,
        summary,
        'meeting' AS type
      FROM meetings
      WHERE title LIKE ?
         OR summary LIKE ?
         OR transcript LIKE ?
      LIMIT 20
      `,
      [
        searchTerm,
        searchTerm,
        searchTerm,
      ]
    );

    const tasks = db.all(
      `
      SELECT
        id,
        task_code,
        title,
        description,
        'task' AS type
      FROM tasks
      WHERE title LIKE ?
         OR description LIKE ?
      LIMIT 20
      `,
      [
        searchTerm,
        searchTerm,
      ]
    );

    const decisions = db.all(
      `
      SELECT
        id,
        title,
        decision,
        'decision' AS type
      FROM decisions
      WHERE title LIKE ?
         OR decision LIKE ?
      LIMIT 20
      `,
      [
        searchTerm,
        searchTerm,
      ]
    );

    res.json({
      success: true,
      query,
      results: [
        ...(meetings || []),
        ...(tasks || []),
        ...(decisions || []),
      ],
    });
  } catch (error) {
    console.error("Search error:", error);

    res.status(500).json({
      success: false,
      message: "Search failed",
      error: error.message,
    });
  }
});

