    res.status(500).json({
      success: false,
      message: "Failed to save transcript",
      error: error.message,
    });
  }
});

// ============================================================
// AI ANALYSIS
// ============================================================

app.post("/api/meetings/:id/analyze", (req, res) => {
  try {
    const meeting = db.get(
      `
      SELECT *
      FROM meetings
      WHERE id = ?
      `,
      [req.params.id]
    );

    if (!meeting) {
      return res.status(404).json({
        success: false,
        message: "Meeting not found",
      });
    }

    const transcript = meeting.transcript || "";

    const summary =
      transcript.length > 0
        ? `AI-generated summary for ${meeting.title}. Transcript contains ${transcript.split(/\s+/).length} words.`
        : `No transcript available for ${meeting.title}.`;

    const executiveOverview =
      transcript.length > 0
        ? "The meeting discussion has been processed and summarized."
        : "Transcript is required for detailed AI analysis.";

    db.run(
      `
      UPDATE meetings
      SET
        summary = ?,
        executive_overview = ?,
        updated_at = CURRENT_TIMESTAMP
      WHERE id = ?
      `,
      [
        summary,
        executiveOverview,
        req.params.id,
      ]
    );

    res.json({
      success: true,
      summary,
      executive_overview: executiveOverview,
    });
  } catch (error) {
    console.error("AI analysis error:", error);

    res.status(500).json({
      success: false,
      message: "AI analysis failed",
      error: error.message,
    });
  }
});

