app.post("/api/demo/seed", (req, res) => {
  try {
    const meetingCountRow = db.get(
      `SELECT COUNT(*) AS c FROM meetings`
    );

    const meetingCount = meetingCountRow?.c || 0;

    if (meetingCount > 0) {
      return res.json({
        success: true,
        message: "Demo data already exists",
      });
    }

    const meeting1 = db.run(
      `
      INSERT INTO meetings
      (
        title,
        description,
        meeting_date,
        status,
        summary,
        executive_overview
      )
      VALUES (?, ?, ?, ?, ?, ?)
      `,
      [
        "Project Kickoff Meeting",
        "Initial project planning meeting",
        new Date().toISOString(),
        "completed",
        "Discussed project architecture and responsibilities.",
        "Frontend, Backend and Database responsibilities were assigned.",
      ]
    );

    const meeting2 = db.run(
      `
      INSERT INTO meetings
      (
        title,
        description,
        meeting_date,
        status,
        summary,
        executive_overview
      )
      VALUES (?, ?, ?, ?, ?, ?)
      `,
      [
        "Sprint Review Meeting",
        "Review of current sprint progress",
        new Date().toISOString(),
        "scheduled",
        "Reviewed task progress and pending work.",
        "Pending tasks were discussed for the next sprint.",
      ]
    );

    // Demo Task 1
    db.run(
      `
      INSERT INTO tasks
      (
        task_code,
        title,
        description,
        meeting_id,
        assigned_to,
        status,
        priority,
        role
      )
      VALUES (?, ?, ?, ?, ?, ?, ?, ?)
      `,
      [
        generateNextTaskCode(),
        "Develop Login Module",
        "Implement authentication UI",
        meeting1.lastID,
        "Frontend Team",
        "completed",
        "high",
        "Frontend",
      ]
    );

    // Demo Task 2
    db.run(
      `
      INSERT INTO tasks
      (
        task_code,
        title,
        description,
        meeting_id,
        assigned_to,
        status,
        priority,
        role
      )
      VALUES (?, ?, ?, ?, ?, ?, ?, ?)
      `,
      [
        generateNextTaskCode(),
        "Create API Endpoints",
        "Develop meeting management APIs",
        meeting2.lastID,
        "Backend Team",
        "in-progress",
        "high",
        "Backend",
      ]
    );

    db.run(
      `
      INSERT INTO decisions
      (
        meeting_id,
        title,
        description,
        decision,
        made_by
      )
      VALUES (?, ?, ?, ?, ?)
      `,
      [
        meeting1.lastID,
        "Use Context-Aware Meeting Intelligence",
        "System should remember previous meetings.",
        "Cross-meeting context will be implemented.",
        "Project Team",
      ]
    );

    res.json({
      success: true,
      message: "Demo data seeded successfully",
    });
  } catch (error) {
    console.error("Seed error:", error);

    res.status(500).json({
      success: false,
      message: "Failed to seed demo data",
      error: error.message,
    });
  }
});

