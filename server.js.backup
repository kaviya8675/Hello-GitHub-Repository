      SELECT *
      FROM meetings
      WHERE id = ?
      `,
      [req.params.id]
    );

    if (!meeting) {
      return res.status(404).json({
        success: false,
        message: "Meeting not found",
      });
    }

    const tasks = db.all(
      `
      SELECT *
      FROM tasks
      WHERE meeting_id = ?
      ORDER BY created_at DESC
      `,
      [req.params.id]
    );

    const decisions = db.all(
      `
      SELECT *
      FROM decisions
      WHERE meeting_id = ?
      ORDER BY created_at DESC
      `,
      [req.params.id]
    );

    res.json({
      success: true,
      meeting,
      tasks: tasks || [],
      decisions: decisions || [],
    });
  } catch (error) {
    console.error("Meeting detail error:", error);

    res.status(500).json({
      success: false,
      message: "Failed to fetch meeting",
      error: error.message,
    });
  }
});

app.post("/api/meetings", (req, res) => {
  try {
    const {
      title,
      description,
      meeting_date,
      duration,
      team_id,
      created_by,
    } = req.body;

    if (!title) {
      return res.status(400).json({
        success: false,
        message: "Meeting title is required",
      });
    }

    const result = db.run(
      `
      INSERT INTO meetings
      (
        title,
        description,
        meeting_date,
        duration,
        team_id,
        created_by,
        status
      )
      VALUES (?, ?, ?, ?, ?, ?, ?)
      `,
      [
        title,
        description || "",
        meeting_date || new Date().toISOString(),
        duration || 0,
        team_id || null,
        created_by || null,
        "scheduled",
      ]
    );

    const meeting = db.get(
      `SELECT * FROM meetings WHERE id = ?`,
      [result.lastID]
    );

    res.status(201).json({
      success: true,
      message: "Meeting created successfully",
      meeting,
    });
  } catch (error) {
    console.error("Create meeting error:", error);

    res.status(500).json({
      success: false,
      message: "Failed to create meeting",
      error: error.message,
    });
  }
});

app.put("/api/meetings/:id", (req, res) => {
  try {
    const {
      title,
      description,
      meeting_date,
      duration,
      status,
      transcript,
      summary,
      executive_overview,
    } = req.body;

    db.run(
      `
      UPDATE meetings
      SET
        title = COALESCE(?, title),
        description = COALESCE(?, description),
        meeting_date = COALESCE(?, meeting_date),
        duration = COALESCE(?, duration),
        status = COALESCE(?, status),
        transcript = COALESCE(?, transcript),
        summary = COALESCE(?, summary),
        executive_overview = COALESCE(?, executive_overview),
        updated_at = CURRENT_TIMESTAMP
      WHERE id = ?
      `,
      [
        title,
        description,
        meeting_date,
        duration,
        status,
        transcript,
        summary,
        executive_overview,
        req.params.id,
      ]
    );

    const meeting = db.get(
      `SELECT * FROM meetings WHERE id = ?`,
      [req.params.id]
    );

    res.json({
      success: true,
      meeting,
    });
  } catch (error) {
    console.error("Update meeting error:", error);

    res.status(500).json({
      success: false,
      message: "Failed to update meeting",
      error: error.message,
    });
  }
});

app.delete("/api/meetings/:id", (req, res) => {
  try {
    const id = req.params.id;

    db.run(`DELETE FROM tasks WHERE meeting_id = ?`, [id]);
    db.run(`DELETE FROM decisions WHERE meeting_id = ?`, [id]);
    db.run(`DELETE FROM meetings WHERE id = ?`, [id]);

    res.json({
      success: true,
      message: "Meeting deleted successfully",
    });
  } catch (error) {
    console.error("Delete meeting error:", error);

    res.status(500).json({
      success: false,
      message: "Failed to delete meeting",
      error: error.message,
    });
  }
});

// ============================================================
// MEETING AUDIO / TRANSCRIPT
// ============================================================

app.post("/api/meetings/:id/audio", (req, res) => {
  try {
    const meetingId = req.params.id;
    const { audio, filename } = req.body;

    if (!audio) {
      return res.status(400).json({
        success: false,
        message: "Audio data is required",
      });
    }

    const safeName =
      filename ||
      `meeting-${meetingId}-${Date.now()}.webm`;

    const filePath = path.join(uploadsDir, safeName);

    try {
      const base64Data = audio.includes(",")
        ? audio.split(",")[1]
        : audio;

      fs.writeFileSync(
        filePath,
        Buffer.from(base64Data, "base64")
      );
    } catch (fileError) {
      console.error("Audio save error:", fileError);

      return res.status(500).json({
        success: false,
        message: "Failed to save audio file",
      });
    }

    const audioUrl = `/uploads/${safeName}`;

    db.run(
      `
      UPDATE meetings
      SET audio_url = ?,
          updated_at = CURRENT_TIMESTAMP
      WHERE id = ?
      `,
      [audioUrl, meetingId]
    );

    res.json({
      success: true,
      message: "Audio uploaded successfully",
      audio_url: audioUrl,
    });
  } catch (error) {
    console.error("Audio upload error:", error);

    res.status(500).json({
      success: false,
      message: "Audio upload failed",
      error: error.message,
    });
  }
});

app.post("/api/meetings/:id/transcript", (req, res) => {
  try {
