});

// ============================================================
// CROSS-MEETING CONTEXT
// ============================================================

app.get("/api/meetings/:id/context", (req, res) => {
  try {
    const meeting = db.get(
      `SELECT * FROM meetings WHERE id = ?`,
      [req.params.id]
    );

    if (!meeting) {
      return res.status(404).json({
        success: false,
        message: "Meeting not found",
      });
    }

    const previousMeetings = db.all(
      `
      SELECT
        id,
        title,
        meeting_date,
        summary,
        executive_overview,
        status
      FROM meetings
      WHERE id < ?
      ORDER BY id DESC
      LIMIT 5
      `,
      [req.params.id]
    );

    const previousTasks = db.all(
      `
      SELECT *
      FROM tasks
      WHERE meeting_id < ?
      ORDER BY created_at DESC
      LIMIT 20
      `,
      [req.params.id]
    );

    const previousDecisions = db.all(
      `
      SELECT *
      FROM decisions
      WHERE meeting_id < ?
      ORDER BY created_at DESC
      LIMIT 20
      `,
      [req.params.id]
    );

    res.json({
      success: true,
      current_meeting: meeting,
      previous_meetings: previousMeetings || [],
      previous_tasks: previousTasks || [],
      previous_decisions: previousDecisions || [],
    });
  } catch (error) {
    console.error("Context error:", error);

    res.status(500).json({
      success: false,
      message: "Failed to retrieve meeting context",
      error: error.message,
    });
  }
});

